# Copy this file to .env and replace the values before running locally
# Do NOT commit your .env file — it's already excluded by .gitignore
SECRET_KEY=replace-with-a-secure-random-string
# Optional: set a DATABASE_URL for production
# DATABASE_URL=sqlite:///instance/books.db
# Optional: override upload root (default: <project>/uploads)
# UPLOAD_ROOT=/var/data/uploads
# Optional media limits (bytes / pixels) — defaults match production
# MEDIA_COVER_MAX_BYTES=5242880
# MEDIA_COVER_MAX_EDGE=600
# MEDIA_AVATAR_MAX_BYTES=2097152
# Optional: Google Books API key (higher quota; search works without it)
# GOOGLE_BOOKS_API_KEY=
